rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: read the caller's user doc to check role / turfId.
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function callerTurfId() {
      return userDoc().turfId;
    }
    function isAdminAt(tid) {
      return userDoc().role == 'ADMIN' && userDoc().turfId == tid;
    }
    function isStaffAt(tid) {
      return userDoc().role == 'STAFF' && userDoc().turfId == tid;
    }
    function isAdminOrStaffAt(tid) {
      return isAdminAt(tid) || isStaffAt(tid);
    }

    // Users collection — each user reads/writes their own doc.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }

    // Turfs — public read so the no-auth schedule page can fetch turf
    // name + admin phone. Writes still restricted to the assigned admin.
    match /turfs/{turfId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.adminPhone == request.auth.token.phone_number;
      allow update: if request.auth != null && isAdminAt(turfId);
      allow delete: if false;

      // Per-turf settings (slot_config). Public read so the no-auth
      // schedule page knows which hours are bookable + the price bands.
      // No PII in here.
      match /settings/{document=**} {
        allow read: if true;
        allow write: if request.auth != null && isAdminAt(turfId);
      }

      // Loyalty rewards per customer (doc id = digits of phone).
      // Writes (claim, increment) are server/admin-driven via sweeps.
      match /rewards/{phone} {
        allow read: if request.auth != null
          && callerTurfId() == turfId;
        allow write: if request.auth != null
          && callerTurfId() == turfId;
      }

      // Academy — squads, players, fee payments. Admin-only writes within
      // the same turf; nested under a static `data` doc so the rule path
      // stays explicit. Reads are allowed for any signed-in member of the
      // turf so coaches/staff can view.
      match /academy/{academyId}/{collection}/{docId} {
        allow read: if request.auth != null
          && callerTurfId() == turfId;
        allow write: if request.auth != null && isAdminAt(turfId);
      }

      // Monthly subscription plans — public read so the no-auth schedule
      // page knows which weekday/hour slots are reserved by plans. Plan
      // docs DO carry customer name/phone; the public UI strips those at
      // display time. Admin-only writes still enforced.
      match /monthly_plans/{planId} {
        allow read: if true;
        allow write: if request.auth != null && isAdminAt(turfId);
      }
      match /monthly_plan_payments/{paymentId} {
        allow read: if request.auth != null
          && callerTurfId() == turfId;
        allow write: if request.auth != null && isAdminAt(turfId);
      }

      // Tournaments + their payment audit log. Tournament docs are also
      // read by anyone fetching that day's bookings (synthesizer), so the
      // read rule mirrors the per-turf scope used by bookings.
      match /tournaments/{tournamentId} {
        allow read: if request.auth != null
          && callerTurfId() == turfId;
        allow write: if request.auth != null && isAdminAt(turfId);
      }
      match /tournament_payments/{paymentId} {
        allow read: if request.auth != null
          && callerTurfId() == turfId;
        allow write: if request.auth != null && isAdminAt(turfId);
      }

      // Holiday dates — public read (schedule page needs to check pricing),
      // admin-only writes.
      match /holidays/{dateKey} {
        allow read: if true;
        allow write: if request.auth != null && isAdminAt(turfId);
      }

      // Concession catalog + sales log. Admin-only writes; reads gated
      // on caller belonging to the turf.
      match /concession_items/{itemId} {
        allow read: if request.auth != null
          && callerTurfId() == turfId;
        allow write: if request.auth != null && isAdminAt(turfId);
      }
      match /concession_sales/{saleId} {
        allow read: if request.auth != null
          && callerTurfId() == turfId;
        allow write: if request.auth != null && isAdminAt(turfId);
      }

      // Concession expense ledger — stock purchases, supplies, etc.
      match /concession_expenses/{expenseId} {
        allow read: if request.auth != null
          && callerTurfId() == turfId;
        allow write: if request.auth != null && isAdminAt(turfId);
      }

      // Cached weekly AI insights — one doc per Sunday-anchored week.
      // Admin-only writes; reads gated on turf membership.
      match /insights/{weekKey} {
        allow read: if request.auth != null
          && callerTurfId() == turfId;
        allow write: if request.auth != null && isAdminAt(turfId);
      }
    }

    // Bookings — public read so the no-auth schedule page can show
    // which hours are taken. Booking docs carry customer name + phone;
    // the public UI strips those at display time. Writes still gated on
    // auth + turfId match.
    match /bookings/{bookingId} {
      allow read: if true;
      // Staff can create bookings but not update/delete/pay.
      allow create: if request.auth != null
        && request.resource.data.turfId == callerTurfId()
        && isAdminOrStaffAt(callerTurfId());
      allow update, delete: if request.auth != null
        && resource.data.turfId == callerTurfId()
        && isAdminAt(callerTurfId());
    }

    // Regular bookings — public read, admin-only writes.
    match /regular_bookings/{regularId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.turfId == callerTurfId()
        && isAdminAt(callerTurfId());
      allow update, delete: if request.auth != null
        && resource.data.turfId == callerTurfId()
        && isAdminAt(callerTurfId());
    }

    // Leaderboard cache (calculated rankings). The cache key is
    // "{turfId}_{monthKey}" which can't be parsed in rules, so we
    // restrict writes to any admin role (the app only writes from the
    // admin UI). Reads are open to any authenticated user.
    match /leaderboard/{cacheKey} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && userDoc().role == 'ADMIN';

      match /entries/{entryId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null
          && userDoc().role == 'ADMIN';
      }
    }

    // Leaderboard name overrides — one doc per turf (doc id = turfId).
    // Admin-only writes; any signed-in member of that turf can read
    // (rewards page and leaderboard page both need this).
    match /leaderboard_overrides/{turfId} {
      allow read: if request.auth != null
        && callerTurfId() == turfId;
      allow write: if request.auth != null
        && isAdminAt(turfId);
    }

    // Legacy global settings (kept readable but slot_config now per-turf).
    match /settings/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
